JOB_DB_PATH=artifacts/flyrank-background-jobs/data/jobs.sqlite3
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=0.35
JOB_STALE_RUNNING_SECONDS=30
WORKER_POLL_SECONDS=0.1
# Leave at 0 in normal operation. The isolated verification harness may set a
# short value to capture a directly observed `running` state.
JOB_EXECUTION_HOLD_SECONDS=0